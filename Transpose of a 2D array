
#include <iostream>
using namespace std;
int main(){

//1.Original 2*3 matrix
int matrix[2][3]={{4,5,6},{6,7,8}};
int transpose[3][2];
//3.Process the swap using Loop
 for (int i=0;i<2;i++){
    for (int j=0;j<3;j++){
        transpose[j][i]=matrix[i][j];// rows become cols here
    }
}
//4.Print the transposed matrix
cout<<"-----Transpose Matrix---------"<<endl;
for(int i=0;i<3;i++){
    for(int j=0;j<2;j++){
        cout<<transpose[i][j]<<" ";
    }
    cout<<endl;
}
return 0;
}
