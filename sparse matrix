#include <stdio.h>

int main()
{
    int a[10][10], sparse[100][3];
    int rows = 3;
    int cols = 3;
    int i, j, k = 1;

    printf("Enter matrix elements:\n");

    for (i = 0; i < rows; i++)
    {
        for (j = 0; j < cols; j++)
        {
            scanf("%d", &a[i][j]);
        }
    }

    /* Store number of rows and columns */
    sparse[0][0] = rows;
    sparse[0][1] = cols;

    /* Store non-zero elements */
    for (i = 0; i < rows; i++)
    {
        for (j = 0; j < cols; j++)
        {
            if (a[i][j] != 0)
            {
                sparse[k][0] = i;
                sparse[k][1] = j;
                sparse[k][2] = a[i][j];
                k++;
            }
        }
    }

    /* Store number of non-zero elements */
    sparse[0][2] = k - 1;

    printf("\nSparse Matrix (Triplet Form):\n");
    printf("Row\tColumn\tValue\n");

    for (i = 0; i < k; i++)
    {
        printf("%d\t%d\t%d\n",
               sparse[i][0],
               sparse[i][1],
               sparse[i][2]);
    }

    return 0;
}
