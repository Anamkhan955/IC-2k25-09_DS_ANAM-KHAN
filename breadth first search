
#include <iostream>
#include <vector>
#include <queue>
using namespace std;

void BFS(int start, vector<int> graph[], int V) {
    bool visited[10] = {false};

    queue<int> q;
    visited[start] = true;
    q.push(start);

    while (!q.empty()) {
        int node = q.front();
        q.pop();

        cout << node << " ";

        for (int x : graph[node]) {
            if (!visited[x]) {
                visited[x] = true;
                q.push(x);
            }
        }
    }
}

int main() {
    int V = 4;
    vector<int> graph[4];

    graph[0] = {1, 2};
    graph[1] = {0, 3};
    graph[2] = {0};
    graph[3] = {1};

    BFS(0, graph, V);

    return 0;
}
